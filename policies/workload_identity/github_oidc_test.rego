token_wrong_issuer := "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5LTEifQ..q_I5dhDSsP-Tn9WWWiokzJzM3XBpF9eO-yjbbdTcOFb7TpMlFSetW-cwi8zw_N0TN5hJVbr0ohA3FJyu4E4_-bhGKcELpq0zmXN87lLguHrem75DPkRq0IYM_CsOmFagrl50puWfKpmwP5PkyrE00L7m1orpxpeXG8sCtb8DmCJuBqymAw3r-BY88El9ZQMgB7RLHxkYn7mJs_GV9meftAamEsMOwhRzYoWGEY_TrNFFVVr3p_vH5iXAEkDlT6mJuZHyICBg58J4Vq-3TVZkZ-C_hqtCcRrCrIHkpi3qGD3EwKbFfkgCBCTuH83S79GT62fOhaJKvdlYaLRSJLXr5w"

token_other_repository := "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5LTEifQ..sy_XYYUbWrdC_dgfb_aCgdnGmS_lrOW5tbXbudhwin1fOuRlJTlCRA7vGJOA-R48I2cGd0CiRvoeeyCSfAEMjbTdCsXcIesJHd3_lcz9H19KTnlvPMmicDl59egvSJGnI-DabEEQQpKAKsY1Y4-NrJUMniERJaUc0YYgOuDpOeF9ciQevISi0MXlYp-minAZCL4LX4hzC-aWv511sDHtH2fioIOq5JR0Pp5X7yOgfb8WAHZQA-LHFgpXnBmIRfyTfHS242HDGePdjzLMZNiYeVTsn_Gkwr0KC4LpCsWy5sw2N5pG2Ew3Axa-5r9oZhmh9oFn6X1ARKwJwYJSOKqZ5A"

token_no_actor := "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5LTEifQ..WQAHPvpG25NvX_lCqugY07LAz7eybWa9oxUePfzSyVdcWuUuLcgfbCyHkwnarjDBxiQlBdkGS7Fy6yS6l-YA1xoAUL-78peCREDbFrvqnVsXtRFdBHtSmhYAD1ktV1nBY5tvCuIM_s8IY5doekBk1OqWEmxxY3hoOmZ5RKekWnP4Tm2ouBEszonV4fs0pRFeHRIN2_mS2A7U1Gw862d45r5C-bwI0UJN4dHiOoBUyoN8uhBzaDAy2mU49WApsruPGZMn0qrHiuV86c5gnEbxdf8xrfdotz5ySnjHHWPK09jAPa6NQrnzufzaxFSSVw--YAgg2Iw9GM_kL-3raWAdXA"

inp(token, now) := {"token": token, "jwks": jwks, "now_ns": now}

rejected(token, now, reason) if {
	not workload_identity.verified with input as inp(token, now) with data.identity_policy as policy
	reason in workload_identity.deny_reasons with input as inp(token, now) with data.identity_policy as policy
}

invalid_token := "token is missing, malformed, expired, or not signed by the issuer for this audience"

test_verifies_valid_token if {
	workload_identity.verified with input as inp(token_valid, during) with data.identity_policy as policy
}

test_identity_from_verified_claims if {
	id := workload_identity.identity with input as inp(token_valid, during) with data.identity_policy as policy
	id.verified == true
	id.agent == "example-org/demo-infra/.github/workflows/change-pipeline.yml@refs/heads/main"
	id.requested_by == "alice"
	id.repository == "example-org/demo-infra"
	id.run_id == "1001"
}

test_rejects_token_signed_by_another_key if rejected(token_wrong_key, during, invalid_token)

test_rejects_wrong_audience if rejected(token_wrong_audience, during, invalid_token)

test_rejects_wrong_issuer if rejected(token_wrong_issuer, during, invalid_token)

test_rejects_expired_token if rejected(token_valid, after, invalid_token)

test_rejects_token_not_yet_valid if rejected(token_valid, before, invalid_token)

test_rejects_malformed_token if rejected("not-a-token", during, invalid_token)

test_rejects_tampered_payload if {
	parts := split(token_valid, ".")
	other := split(token_other_repository, ".")
	tampered := concat(".", [parts[0], other[1], parts[2]])
	rejected(tampered, during, invalid_token)
}

test_rejects_missing_token if {
	not workload_identity.verified with input as {"jwks": jwks, "now_ns": during} with data.identity_policy as policy
}

test_rejects_missing_jwks if {
	not workload_identity.verified with input as {"token": token_valid, "now_ns": during} with data.identity_policy as policy
}

test_rejects_repository_not_allowed if {
	rejected(token_other_repository, during, "repository is not allowed to run this pipeline")
}

test_rejects_token_without_actor if rejected(token_no_actor, during, "token has no actor claim")

test_rejects_when_policy_data_missing if {
	not workload_identity.verified with input as inp(token_valid, during)
	"identity policy data is missing" in workload_identity.deny_reasons with input as inp(token_valid, during)
}

test_unverified_identity_exposes_no_claims if {
	id := workload_identity.identity with input as inp(token_wrong_key, during) with data.identity_policy as policy
	id.verified == false
	not id.agent
	not id.requested_by
}
