package agentaccess.workload_identity_test

import data.agentaccess.workload_identity

# Test fixtures. The tokens were signed with throwaway RSA keys generated
# for these tests; the private keys were discarded and exist nowhere. The
# claims are invented and valid from 2026-11-09T12:00:00Z for 15 minutes.

policy := {
	"issuer": "https://token.actions.githubusercontent.com",
	"audience": "agent-access-controls",
	"repositories": ["example-org/demo-infra"],
}

# 2026-11-09T12:05:00Z
during := 1794225900000000000

# 2026-11-09T11:00:00Z
before := 1794222000000000000

# 2026-11-09T13:00:00Z
after := 1794229200000000000

